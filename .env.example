# GeoTrace sidecar — environment variables
# Copy to .env and fill in values. Never commit .env.

# Required
DATABASE_DSN=postgres://geotrace:password@localhost:5432/geotrace?sslmode=disable
MAXMIND_DB_PATH=./GeoLite2-City.mmdb

# Optional (defaults shown)
PORT=8090
MIGRATIONS_DIR=./migrations
ENRICHER_WORKERS=4
CHANNEL_BUFFER=512
CORS_ORIGINS=http://localhost:5173

# Leave empty in dev to skip ingest auth
INGEST_API_KEY=
